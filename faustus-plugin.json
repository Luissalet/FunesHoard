{
  "schema": 1,
  "id": "funes",
  "name": "Funes's Hoard · Talos",
  "purpose": "Absorbed by Talos's Hoard. Compatibility identity only; no standalone server. Gives the assistant a local memory of desktop activity and audio sessions. Records and transcribes meetings and voice notes, searches transcripts, and merges them with screen and clipboard memory in one citable timeline.",
  "capabilities": [
    "activity timeline",
    "day summaries",
    "resume context",
    "recent files",
    "git commits",
    "activity search",
    "audio recording",
    "live and final transcription",
    "meeting search and notes",
    "audio import and export",
    "meeting minutes with action items",
    "import audio by file path",
    "federated recall (screen, clipboard, audio)"
  ],
  "placeholders": [
    "FUNES_DIR",
    "APP_URL"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5220/legacy/funes",
    "TALOS_DIR": "{FUNES_DIR}/../Talos's Hoard"
  },
  "app": {
    "url_default": "http://127.0.0.1:5220/legacy/funes",
    "ui_url": "http://127.0.0.1:5220/",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "absorbed-funes"
      }
    },
    "identify": {
      "service": [
        "funes-hoard"
      ],
      "title": [
        "funes's hoard"
      ]
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{TALOS_DIR}/.venv/Scripts/python.exe",
    "args": [
      "{TALOS_DIR}/mcp_server.py"
    ],
    "env": {
      "TALOS_URL": "http://127.0.0.1:5220",
      "TALOS_TOKEN_FILE": "{TALOS_DIR}/data/mcp-token"
    },
    "optional_env": [
      "TALOS_DATA_DIR"
    ]
  },
  "x-family": {
    "copilot": true,
    "absorbed_by": {
      "id": "talos",
      "repository": "https://github.com/Luissalet/TalosHoard",
      "module": "legacy/funes",
      "standalone": false
    }
  },
  "provides": {
    "skills": [
      "skills/where-was-i/SKILL.md"
    ]
  },
  "notes": "Absorbed by Talos's Hoard: https://github.com/Luissalet/TalosHoard. Compatibility identity only. Start the merged app explicitly and enable its module there. This entry preserves family calls, tokens and existing data; it never owns or stops the merged process."
}
